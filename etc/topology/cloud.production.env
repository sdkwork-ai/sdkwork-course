# Bootstrap profile cloud.production — replace with application-specific values.
SDKWORK_COURSE_DEPLOYMENT_PROFILE=cloud
SDKWORK_COURSE_ENVIRONMENT=production
SDKWORK_COURSE_PROFILE_ID=cloud.production
SDKWORK_COURSE_APPLICATION_PUBLIC_HTTP_URL=https://course.sdkwork.com
