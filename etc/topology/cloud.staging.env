# Bootstrap profile cloud.staging — replace with application-specific values.
SDKWORK_COURSE_DEPLOYMENT_PROFILE=cloud
SDKWORK_COURSE_ENVIRONMENT=staging
SDKWORK_COURSE_PROFILE_ID=cloud.staging
SDKWORK_COURSE_APPLICATION_PUBLIC_HTTP_URL=https://course-staging.sdkwork.com
SDKWORK_COURSE_PLATFORM_API_GATEWAY_HTTP_URL=https://api-staging.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_COURSE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

