# Bootstrap profile standalone.production — replace with application-specific values.
SDKWORK_COURSE_DEPLOYMENT_PROFILE=standalone
SDKWORK_COURSE_ENVIRONMENT=production
SDKWORK_COURSE_PROFILE_ID=standalone.production
SDKWORK_COURSE_APPLICATION_PUBLIC_HTTP_URL=https://course.sdkwork.com
SDKWORK_COURSE_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:3900
SDKWORK_COURSE_PC_STATIC_ROOT=/usr/share/sdkwork/course/web/pc


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_COURSE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
