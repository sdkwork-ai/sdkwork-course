# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_course_demo`
# and a dedicated Redis logical DB index so no cache key ever collides with another shared-redis environment.
SDKWORK_COURSE_DEPLOYMENT_PROFILE=standalone
SDKWORK_COURSE_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_COURSE_PROFILE_ID=standalone.demo
SDKWORK_COURSE_APPLICATION_PUBLIC_HTTP_URL=https://course-demo.sdkwork.com
SDKWORK_COURSE_WEB_DEV_INGRESS_BIND=127.0.0.1:5247
SDKWORK_COURSE_PC_INTERNAL_DEV_PORT=5249
SDKWORK_COURSE_H5_INTERNAL_DEV_PORT=5250
SDKWORK_COURSE_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:3900


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_COURSE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_CORS_ALLOWED_ORIGINS=https://course-demo.sdkwork.com,http://course-demo.sdkwork.com,https://course-demo.birdcoder.com,http://course-demo.birdcoder.com,https://course-demo.dtupay.com,http://course-demo.dtupay.com,https://course-demo.noaper.com,http://course-demo.noaper.com,https://course-demo.sdkwork.cn,http://course-demo.sdkwork.cn,https://course-demo.birdcoder.cn,http://course-demo.birdcoder.cn,https://course-demo.dtupay.cn,http://course-demo.dtupay.cn,https://course-demo.noaper.cn,http://course-demo.noaper.cn,https://course-demo.skubc.com,http://course-demo.skubc.com,https://course-demo.skubc.cn,http://course-demo.skubc.cn,https://course-demo.zowalk.com,http://course-demo.zowalk.com,https://course-demo.zowalk.cn,http://course-demo.zowalk.cn,https://course-demo.offer86.com,http://course-demo.offer86.com,https://course-demo.offer86.cn,http://course-demo.offer86.cn,https://course-demo.86offer.com,http://course-demo.86offer.com,https://course-demo.86offer.cn,http://course-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
