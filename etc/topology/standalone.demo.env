# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_course_demo`
# and a dedicated Redis logical DB index so no cache key ever collides with another shared-redis environment.
SDKWORK_COURSE_DEPLOYMENT_PROFILE=standalone
SDKWORK_COURSE_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_COURSE_PROFILE_ID=standalone.demo
SDKWORK_COURSE_APPLICATION_PUBLIC_HTTP_URL=https://course-demo.sdkwork.com
SDKWORK_COURSE_WEB_DEV_INGRESS_BIND=127.0.0.1:5247
SDKWORK_COURSE_PC_INTERNAL_DEV_PORT=5249
SDKWORK_COURSE_H5_INTERNAL_DEV_PORT=5250
SDKWORK_COURSE_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:3900


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_COURSE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
