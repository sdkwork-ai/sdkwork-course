# Bootstrap profile cloud.development — replace with application-specific values.
SDKWORK_COURSE_DEPLOYMENT_PROFILE=cloud
SDKWORK_COURSE_ENVIRONMENT=development
SDKWORK_COURSE_PROFILE_ID=cloud.development
SDKWORK_COURSE_APPLICATION_PUBLIC_HTTP_URL=https://course-dev.sdkwork.com
SDKWORK_COURSE_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com
SDKWORK_COURSE_WEB_DEV_INGRESS_BIND=127.0.0.1:5247
SDKWORK_COURSE_PC_INTERNAL_DEV_PORT=5249
SDKWORK_COURSE_H5_INTERNAL_DEV_PORT=5250


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_COURSE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN


# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL to the sdkwork-api-cloud-gateway started by its own dev command
# (bind 127.0.0.1:3900), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
SDKWORK_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5247,http://localhost:5247,https://course-dev.sdkwork.com,http://course-dev.sdkwork.com,https://course-dev.birdcoder.com,http://course-dev.birdcoder.com,https://course-dev.dtupay.com,http://course-dev.dtupay.com,https://course-dev.noaper.com,http://course-dev.noaper.com,https://course-dev.sdkwork.cn,http://course-dev.sdkwork.cn,https://course-dev.birdcoder.cn,http://course-dev.birdcoder.cn,https://course-dev.dtupay.cn,http://course-dev.dtupay.cn,https://course-dev.noaper.cn,http://course-dev.noaper.cn,https://course-dev.skubc.com,http://course-dev.skubc.com,https://course-dev.skubc.cn,http://course-dev.skubc.cn,https://course-dev.zowalk.com,http://course-dev.zowalk.com,https://course-dev.zowalk.cn,http://course-dev.zowalk.cn,https://course-dev.offer86.com,http://course-dev.offer86.com,https://course-dev.offer86.cn,http://course-dev.offer86.cn,https://course-dev.86offer.com,http://course-dev.86offer.com,https://course-dev.86offer.cn,http://course-dev.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
