# Bootstrap profile cloud.development — replace with application-specific values.
SDKWORK_COURSE_DEPLOYMENT_PROFILE=cloud
SDKWORK_COURSE_ENVIRONMENT=development
SDKWORK_COURSE_PROFILE_ID=cloud.development
SDKWORK_COURSE_APPLICATION_PUBLIC_HTTP_URL=https://course-dev.sdkwork.com
SDKWORK_COURSE_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com
SDKWORK_COURSE_WEB_DEV_INGRESS_BIND=127.0.0.1:5247
SDKWORK_COURSE_PC_INTERNAL_DEV_PORT=5249
SDKWORK_COURSE_H5_INTERNAL_DEV_PORT=5250


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_COURSE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

