    "applicationServer": {
      "crate": "sdkwork-api-course-assembly",
      "binary": "sdkwork-api-course-assembly"
    }
  },
  "orchestration": {
    "profiles": {
      "standalone.development": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-course-assembly",
            "binary": "sdkwork-api-course-assembly",
            "required": true,
            "role": "api-standalone-gateway"
          },
          {
            "id": "course-browser",
            "role": "client",
            "applicationRoot": "apps/sdkwork-course-pc",
            "bindEnv": "SDKWORK_COURSE_WEB_DEV_INGRESS_BIND",
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "required": true
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ],
        "browserDeliveries": [
          {
            "id": "course-adaptive-web",
            "applicationRoot": "apps/sdkwork-course-pc",
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "originMode": "same-origin",
            "deliveryMode": "dev-server-proxy",
            "clientProcessId": "course-browser",
            "apiSurfaceId": "application.public-ingress",
            "preserveCanonicalPaths": true,
            "tabletArchitecture": "pc-web",
            "renderers": {
              "pc-web": {
                "applicationRoot": "apps/sdkwork-course-pc",
                "script": "dev",
                "defaultPort": 5249,
                "portEnv": "SDKWORK_COURSE_PC_INTERNAL_DEV_PORT",
                "env": {}
              },
              "h5": {
                "applicationRoot": "apps/sdkwork-course-h5",
                "script": "dev",
                "defaultPort": 5250,
